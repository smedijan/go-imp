{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://imp.smedijan.se/schema/configuration.json",
  "title": "The imp configuration schema",
  "type": "object",
  "properties": {
    "quiet": {
      "title": "Quiet mode",
      "description": "Suppress interactive progress, never the report or errors",
      "type": "boolean",
      "default": false
    },
    "no-color": {
      "title": "Disable color",
      "description": "Disable ANSI colors in reports and diagnostics",
      "type": "boolean",
      "default": false
    },
    "run": {
      "type": "object",
      "properties": {
        "json": {
          "title": "JSON report",
          "description": "Write grouped JSON instead of human-readable text",
          "type": "boolean",
          "default": false
        },
        "verbose": {
          "title": "Verbose report",
          "description": "Expand source context and test commands for every selected status in human output",
          "type": "boolean",
          "default": false
        },
        "statuses": {
          "title": "Selected statuses",
          "description": "Comma-separated lived, not-covered, timed-out, runnable, killed, skipped, not-viable; empty selects all. Filters findings in every format, not aggregate metrics.",
          "type": "string",
          "default": "",
          "examples": ["lived,not-covered", "killed"]
        },
        "exclude-files": {
          "title": "File exclusions",
          "description": "Regular expressions matching source paths excluded from mutation discovery; takes precedence over generated-file detection and include-files.",
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "include-files": {
          "title": "File inclusions",
          "description": "Regular expressions matching source paths included despite generated-file detection; exclude-files takes precedence.",
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "exclude-workdir": {
          "title": "Worker-copy exclusions",
          "description": "Module-relative file or directory paths omitted from worker copies; directories are pruned recursively. Does not follow .gitignore.",
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "examples": [["ignored-cache", "generated-data"]]
        },
        "dry-run": {
          "title": "Dry-run mode",
          "description": "Searches for mutants but doesn't execute the tests",
          "type": "boolean",
          "default": false
        },
        "diff": {
          "title": "Git comparison ref",
          "description": "Select impact against the Git merge base; empty disables selection",
          "type": "string",
          "default": ""
        },
        "diff-scope": {
          "title": "Diff selection policy",
          "description": "Requested scope; test, deletion, dependency and configuration changes can expand it conservatively",
          "type": "string",
          "enum": ["changed-line", "changed-function", "affected-package"],
          "default": "changed-line"
        },
        "tags": {
          "title": "Tags",
          "description": "The build tags for the Go module to be tested",
          "type": "string",
          "default": "",
          "examples": [
            "tag1,tag2,tag4"
          ]
        },
        "coverpkg": {
          "title": "Cover packages",
          "description": "Apply coverage analysis in each test to packages matching the patterns",
          "type": "string",
          "default": "",
          "examples": [
            "./internal/log,./pkg/..."
          ]
        },
        "output": {
          "title": "Output",
          "description": "Destination for the selected report format; empty or - means stdout. Does not infer format from the filename.",
          "type": "string",
          "default": "",
          "examples": [
            "output.json"
          ]
        },
        "threshold": {
          "title": "Thresholds",
          "description": "The thresholds under which imp exits with an error",
          "type": "object",
          "default": {},
          "required": [],
          "properties": {
            "efficacy": {
              "title": "Test efficacy",
              "description": "Test efficacy threshold",
              "type": "number",
              "default": 0,
              "minimum": 0,
              "maximum": 100,
              "examples": [
                81.2,
                10
              ]
            },
            "mutant-coverage": {
              "title": "Mutant-coverage",
              "description": "Mutant coverage threshold",
              "type": "number",
              "default": 0,
              "minimum": 0,
              "maximum": 100,
              "examples": [
                81.2,
                10
              ]
            }
          }
        }
      }
    },
    "mutants": {
      "title": "Supported mutants",
      "type": "object",
      "properties": {
        "arithmetic-base": {
          "title": "The arithmetic-base Schema",
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": true
            }
          }
        },
        "conditionals-boundary": {
          "title": "The conditionals-boundary Schema",
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": true
            }
          }
        },
        "conditionals-negation": {
          "title": "The conditionals-negation Schema",
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": true
            }
          }
        },
        "increment-decrement": {
          "title": "The increment-decrement Schema",
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": true
            }
          }
        },
        "invert-negatives": {
          "title": "The invert-negatives Schema",
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": true
            }
          }
        },
        "invert-loopctrl": {
          "title": "The invert-loopctrl Schema",
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": false
            }
          }
        },
        "invert-assignments": {
          "title": "The invert-assignments Schema",
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": false
            }
          }
        },
        "invert-bitwise": {
          "title": "The invert-bitwise Schema",
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": false
            }
          }
        },
        "invert-bwassign": {
          "title": "The invert-bwassign Schema",
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": false
            }
          }
        },
        "remove-self-assignments": {
          "title": "The remove-self-assignments Schema",
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "title": "The enabled Schema",
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    }
  }
}